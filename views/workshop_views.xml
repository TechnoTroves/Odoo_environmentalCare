<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_envcare_workshop_list" model="ir.ui.view">
        <field name="name">envcare.workshop.list</field>
        <field name="model">envcare.workshop</field>
        <field name="arch" type="xml">
            <list string="Workshops">
                <field name="name"/>
                <field name="event_id"/>
                <field name="workshop_lead_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="is_canceled" widget="boolean_toggle" readonly="1" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_envcare_workshop_form" model="ir.ui.view">
        <field name="name">envcare.workshop.form</field>
        <field name="model">envcare.workshop</field>
        <field name="arch" type="xml">
            <form string="Workshop">
                <!-- No status: the whole workshop is always visible. Editable by IT / Admin,
                     the parent event's Events Head, the Workshop Lead and Deputy (not when canceled). -->
                <field name="can_edit" invisible="1"/>
                <field name="can_cancel" invisible="1"/>
                <sheet>
                    <widget name="web_ribbon" title="Canceled" bg_color="bg-danger" invisible="not is_canceled"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="not can_edit"/>
                        </h1>
                        <field name="description" readonly="not can_edit"/>
                    </div>
                    <group string="Workshop Details">
                        <group>
                            <group>
                                <field name="event_id" readonly="not can_edit"/>
                                <field name="workshop_lead_id" options="{'no_create':True}" readonly="not can_edit"/>
                                <field name="workshop_deputy_id" options="{'no_create':True}" readonly="not can_edit"/>
                            </group>
                            <group>
                                <label for="date_start" string="Workshop Timing"/>
                                <div class="o_row">
                                    <field name="date_start" widget="daterange" options="{'related_end_date': 'date_end'}" readonly="not can_edit"/>
                                    <i class="fa fa-long-arrow-right mx-2 text-muted" title="To" aria-label="To"/>
                                    <field name="date_end" readonly="not can_edit"/>
                                </div>
                                <field name="event_creator_id" readonly="not can_edit"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="sevak_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}" readonly="not can_edit"/>
                                <field name="is_canceled" widget="boolean_toggle" readonly="not can_cancel"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Workshop Item List">
                                <field name="items_ids" readonly="not can_edit">
                                    <list editable="bottom">
                                        <field name="product_id" options="{'no_create':True}"/>
                                        <field name="qty"/>
                                        <field name="item_image" class="" widget="image"/>
                                        <field name="remarks"/>
                                        <field name="availability" readonly="1" decoration-success="is_available == True" decoration-danger="is_available == False"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                    <group string="Additional Details">
                        <field name="pitch_deck" widget="many2many_binary" string="" readonly="not can_edit"/>
                        <notebook>
                            <page string="Budget">
                                <field name="budgets_ids" readonly="not can_edit">
                                    <list editable="bottom">
                                        <field name="workshop_id" readonly="1"/>
                                        <field name="name"/>
                                        <field name="category_id"/>
                                        <field name="quantity"/>
                                        <field name="amount"/>
                                        <field name="bills" widget="many2many_binary"/>
                                        <field name="remarks"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                    <group string="Live">
                        <field name="process" readonly="not can_edit"/>
                        <field name="design_requirements" readonly="not can_edit"/>
                        <field name="design_collaterals" widget="many2many_binary" readonly="not can_edit"/>
                        <field name="statistics_product_impact" readonly="not can_edit"/>
                        <field name="talkie" readonly="not can_edit"/>
                    </group>
                    <group string="Closure">
                        <notebook>
                            <page string="Accounts">
                                <field name="accounts_ids" readonly="not can_edit">
                                    <list editable="bottom">
                                        <field name="workshop_id" readonly="1"/>
                                        <field name="name"/>
                                        <field name="category_id"/>
                                        <field name="quantity"/>
                                        <field name="amount"/>
                                        <field name="bills" widget="many2many_binary"/>
                                        <field name="sevaks_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                        <field name="paid_by" options="{'no_create': True}"/>
                                        <field name="remarks"/>
                                        <field name="re_imbursement"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                        <field name="statistics_workshop" readonly="not can_edit"/>
                        <field name="av_footage" widget="many2many_binary" readonly="not can_edit"/>
                        <field name="docs_files" widget="many2many_binary" readonly="not can_edit"/>
                        <notebook>
                            <page string="Documents">
                                <field name="doc_id" readonly="not can_edit">
                                    <list editable="bottom">
                                        <field name="docs_urls" widget="url" placeholder="https://docs.google.com/document/d/"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_envcare_workshop" model="ir.actions.act_window">
        <field name="name">Workshops</field>
        <field name="res_model">envcare.workshop</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <!-- Menu Item -->
    <menuitem id="menu_envcare_workshop" name="Workshops" parent="menu_envcare_root" action="action_envcare_workshop" sequence="20"/>

</odoo>