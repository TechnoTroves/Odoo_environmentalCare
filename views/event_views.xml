<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View-->
    <record id="view_envcare_event_list" model="ir.ui.view">
        <field name="name">envcare.event.list</field>
        <field name="model">envcare.event</field>
        <field name="arch" type="xml">
            <list string="Events">
                <field name="name"/>
                <field name="date_begin"/>
                <field name="date_end"/>
                <field name="deadline"/>
                <field name="location"/>
                <field name="status" widget="badge" decoration-muted="status == 'draft'" decoration-primary="status == 'live'" decoration-success="status == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_envcare_event_form" model="ir.ui.view">
        <field name="name">envcare.event.form</field>
        <field name="model">envcare.event</field>
        <field name="arch" type="xml">
            <form string="Event">
                <header>
                    <button class="oe_highlight" name="action_set_live" string="Set Live" type="object" invisible="status != 'draft'"/>
                    <button name="action_set_closed" string="Close Event" type="object" invisible="status != 'live'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,live,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Event Name"/>
                        </h1>
                        <field name="description"/>
                    </div>
                    <group>
                        <group>
                            <label for="date_begin" string="Event Duration"/>
                            <div class="o_row">
                                <field name="date_begin" widget="daterange" options="{'related_end_date': 'date_end'}"/>
                                <i class="fa fa-long-arrow-right mx-2 text-muted" title="To" aria-labeled="To"/>
                                <field name="date_end"/>
                            </div>
                            <field name="deadline"/>
                        </group>
                        <group>
                            <field name="location"/>
                            <!-- <field name="status"/> -->
                        </group>
                    </group>
                    <notebook>
                        <page string="Documents">
                            <field name="document_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Workshops">
                            <field name="workshop_ids">
                                <list editable="bottom">
                                    <field name="event_id" readonly="1"/>
                                    <field name="name"/>
                                    <field name="workshop_lead_id"/>
                                    <field name="workshop_deputy_id"/>
                                    <field name="date_start" readonly="1"/>
                                    <field name="date_end" readonly="1"/>
                                    <field name="state"/>
                                    <button type="object" name="action_open_workshop" icon="fa-external-link" title="Open Workshop" aria-label="Open Workshop"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                </chatter>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_envcare_event" model="ir.actions.act_window">
        <field name="name">Events</field>
        <field name="res_model">envcare.event</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_envcare_event" name="Events" parent="menu_envcare_root" action="action_envcare_event" sequence="10"/>
</odoo>