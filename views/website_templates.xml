<odoo>
    <!-- Event List -->
    <template id="event_list_template" name="Event List">
        <t t-call="website.layout">
            <div class="container my-5">
                <h1 class="mb-4">Environmental Care Events</h1>
                <table class="table table-hover table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Event Name</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Deadline</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="events" t-as="event">
                            <tr>
                                <td><span t-field="event.name"/></td>
                                <td><span t-field="event.date_begin"/></td>
                                <td><span t-field="event.date_end"/></td>
                                <td><span t-field="event.deadline"/></td>
                                <td><span t-field="event.location"/></td>
                                <td><span t-field="event.status" t-attf-class="badge #{'text-bg-info bg-info' if event.status == 'draft' else 'text-bg-success bg-success' if event.status == 'live' else 'text-bg-warning bg-warning'}"/></td>
                                <td>
                                    <a t-att-href="'/event/%s' % event.id" class="btn btn-sm btn-primary">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <!-- Event Details -->
    <template id="event_detail_template" name="Event Detail">
        <t t-call="website.layout">
            <div class="container my-5">
                <div class="row mb-4">
                    <div class="col-md-8">
                        <h1 t-field="event.name"/>
                    </div>
                    <div class="col-md-4 text-end">
                        <a href="/events" class="btn btn-secondary me-2">Back to List</a>
                        <!-- Edit Button visible based on access -->
                        <t t-if="can_edit">
                            <a t-att-href="'/event/edit/%s' % event.id" class="btn btn-primary">
                                <i class="fa fa-edit"/> Edit Event
                            </a>
                        </t>    
                    </div>
                </div>
                <div class="card p-4 shadow-sm">
                    <p><strong>Event Status: </strong><span t-field="event.status"/></p>
                    <p><strong>Event Name: </strong><span t-field="event.name"/></p>
                    <p><strong>Description: </strong><span t-field="event.description"/></p>
                    <p>
                        <strong>Event Duration: </strong>
                        <div>
                            <span t-field="event.date_begin"/>
                            <i class="fa fa-long-arrow-right mx-2 text-muted" title="To" aria-labeled="To"/>
                            <span t-field="event.date_end"/>
                        </div>
                    </p>
                    <p><strong>Location: </strong><span t-field="event.location"/></p>
                    <p><strong>Deadline: </strong><span t-field="event.deadline"/></p>
                    <div t-if="event.document_ids" class="mt-4">
                        <h5>Documents</h5>
                        <div class="row g-3">
                            <t t-foreach="event.document_ids" t-as="doc">
                                <div class="col-md-4">
                                    <!-- Images -->
                                    <t t-if="doc.mimetype and doc.mimetype.startswith('image/')">
                                        <a t-attf-href="/web/image/#{doc.id}" target="_blank">
                                            <img t-attf-src="/web/image/#{doc.id}"
                                                class="img-fluid rounded"
                                                t-att-alt="doc.name"/>
                                        </a>
                                        <div class="small mt-1" t-field="doc.name"/>
                                    </t>
                                    <!-- Video -->
                                    <t t-elif="doc.mimetype and doc.mimetype.startswith('video/')">
                                        <video class="w-100 rounded" controls="controls">
                                            <source t-attf-src="/web/content/#{doc.id}" t-att-type="doc.mimetype"/>
                                        </video>
                                        <div class="small mt-1" t-field="doc.name"/>
                                    </t>
                                    <!-- PDF preview + download -->
                                    <t t-elif="doc.mimetype == 'application/pdf'">
                                        <iframe t-attf-src="/web/content/#{doc.id}" class="w-100 rounded" height="320"/>
                                        <a t-attf-href="/web/content/#{doc.id}?download=true" class="d-block mt-1">
                                            <span t-field="doc.name"/>
                                        </a>
                                    </t>
                                    <!-- Other files: download only -->
                                    <t t-else="">
                                        <a t-attf-href="/web/content/#{doc.id}?download=true" class="d-block">
                                            <i class="fa fa-file-o me-1"/>
                                            <span t-esc="doc.name"/>
                                        </a>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div t-if="event.workshop_ids" class="mt-4">
                        <h5>Workshops</h5>
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>Workshop</th>
                                    <th>Lead</th>
                                    <th>Deputy</th>
                                    <th>Timing</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="event.workshop_ids" t-as="workshop">
                                    <tr>
                                        <td>
                                            <span t-field="workshop.name"/>
                                            <div class="text-muted small" t-if="workshop.description" t-field="workshop.description"/>
                                        </td>
                                        <td><span t-field="workshop.workshop_lead_id.name"/></td>
                                        <td><span t-field="workshop.workshop_deputy_id.name"/></td>
                                        <td>
                                            <span t-field="workshop.date_start"/>
                                            <i class="fa fa-long-arrow-right mx-1 text-muted"/>
                                            <span t-field="workshop.date_end"/>
                                        </td>
                                        <td>
                                            <span t-field="workshop.state"
                                                t-attf-class="badge #{'text-bg-secondary bg-secondary' if workshop.state == 'draft' else 'text-bg-danger bg-danger' if workshop.state == 'canceled' else 'text-bg-success bg-success' if workshop.state == 'closed' else 'text-bg-info bg-info'}"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <p><strong>Created By: </strong><span t-field="event.create_uid.name"/></p>
                </div>
            </div>
        </t>
    </template>

    <!-- Event Form -->
    <template id="event_form_template" name="Event Form">
        <t t-call="website.layout">
            <div class="container my-5">
                <h1 class="mb-4">Edit Event <span t-field="event.name"/></h1>
                <form t-att-action="'/event/update/%s' % event.id" method="POST" class="card p-4 shadow-sm">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="mb-3">
                        <label for="name" class="form-label">Event Name</label>
                        <input type="text" class="form-control" name="name" t-att-value="event.name" required="True"/>
                    </div>
                    <div class="d-flex justify-content-between">
                        <a t-att-href="'/event/%s' % event.id" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success">Save Changes</button>
                    </div>
                </form>
            </div>
        </t>
    </template>
</odoo>